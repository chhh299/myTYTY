<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 1. 原生顶栏 (无任何虚假 9:41/wifi/电池状态栏) -->
    <LinearLayout
        android:id="@+id/nativeTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/white"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mytyty"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUrlSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="极简卡片 · 听悟引擎已直通"
                android:textColor="#86909C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 刷新按钮 -->
        <ImageButton
            android:id="@+id/btnRefreshPage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/primary_dark"
            android:contentDescription="刷新" />

        <!-- 设置按钮 -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/primary_dark"
            android:contentDescription="设置" />
    </LinearLayout>

    <!-- 网页加载进度条 -->
    <ProgressBar
        android:id="@+id/pageProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent_green"
        android:visibility="gone" />

    <!-- 2. 双层核心容器：前台极简移动卡片 UI + 后台真实听悟 PC 引擎 -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 引擎：真实通义听悟 PC 运行环境 (常驻底层，绝不使用 View.GONE，保证 Chromium 与 WebRTC 麦克风物理收音 100% 活跃) -->
        <WebView
            android:id="@+id/engineWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- 前台：极简移动端卡片 UI (覆盖在引擎之上，通过显隐控制前台呈现) -->
        <WebView
            android:id="@+id/uiWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />
    </FrameLayout>

    <!-- 3. 原生底部四大导航 Tab 栏 -->
    <LinearLayout
        android:id="@+id/nativeBottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp">

        <!-- Tab 1: 主页 (账号登录与听悟工作台) -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主页"
                android:textSize="14sp"
                android:textColor="@color/nav_inactive" />

            <View
                android:id="@+id/dotHome"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/shape_nav_dot"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Tab 2: 实时 (专属移动端极简卡片，实时录音与双语字幕) -->
        <LinearLayout
            android:id="@+id/tabLive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />

            <View
                android:id="@+id/dotLive"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/shape_nav_dot"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Tab 3: 历史 (云端已存会议纪要) -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史"
                android:textSize="14sp"
                android:textColor="@color/nav_inactive" />

            <View
                android:id="@+id/dotHistory"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/shape_nav_dot"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Tab 4: 设置 (屏幕常亮与显示控制) -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="14sp"
                android:textColor="@color/nav_inactive" />

            <View
                android:id="@+id/dotSettings"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/shape_nav_dot"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
